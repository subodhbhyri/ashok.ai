{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashok.ai/schemas/playbook.schema.json",
  "title": "Playbook",
  "description": "A playbook file from playbooks/ (YAML), as parsed to JSON. Same step schema as a plan, but targets never carry a ref (refs are only valid inside one snapshot).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "os", "examples", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "os": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["win10", "win11"] }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "allOf": [
        { "$ref": "https://ashok.ai/schemas/plan.schema.json#/$defs/step" },
        {
          "type": "object",
          "properties": {
            "target": { "type": "object", "not": { "required": ["ref"] } },
            "doneWhen": {
              "type": "object",
              "properties": {
                "target": { "type": "object", "not": { "required": ["ref"] } }
              }
            }
          }
        }
      ]
    }
  }
}
