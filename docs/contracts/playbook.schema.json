{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashok.ai/schemas/playbook.schema.json",
  "title": "Playbook",
  "description": "A playbook file from playbooks/ (YAML), as parsed to JSON. Same step schema as a plan, but targets never carry a ref (refs are only valid inside one snapshot).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "scope", "os", "examples", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "scope": {
      "description": "system: about Windows itself (Settings, Explorer, desktop); only used over the user's own app when the match is very close. app: about one specific application.",
      "enum": ["system", "app"]
    },
    "avoidWords": {
      "description": "Words or phrases (whole-word sequences, case-insensitive; a * between words matches 0 to 2 words) that mean the person wants the opposite of what this playbook does. A question containing any of them never matches this playbook.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z]+( (\\* )?[A-Za-z]+)*$" }
    },
    "os": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["win10", "win11"] }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "allOf": [
        { "$ref": "https://ashok.ai/schemas/plan.schema.json#/$defs/step" },
        {
          "type": "object",
          "properties": {
            "target": { "type": "object", "not": { "required": ["ref"] } },
            "doneWhen": {
              "type": "object",
              "properties": {
                "target": { "type": "object", "not": { "required": ["ref"] } }
              }
            }
          }
        }
      ]
    }
  }
}
